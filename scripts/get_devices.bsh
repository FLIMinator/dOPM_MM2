// Print all device names known to the Core
print("\n=== DEVICE LIST ===");
try {
    var dev = mmc.getLoadedDevices();
    for (int i=0; i<dev.size(); i++) {
        print("Device: " + dev.get(i));
    }
} catch(Exception e) {
    print("Could not get loaded devices: " + e);
}


// Print default XY and default Z stages
try {
    String xy = mmc.getXYStageDevice();
    print("\nDefault XY stage = " + xy);
} catch(Exception e){
    print("No default XY stage");
}

try {
    String z = mmc.getFocusDevice();
    print("Default Z stage = " + z);
} catch(Exception e){
    print("No default Z stage");
}


// Print default camera device (helpful)
try {
    String cam = mmc.getCameraDevice();
    print("\nDefault Camera = " + cam);
} catch(Exception e) {
    print("No default camera");
}

print("\n=== END ===\n");
